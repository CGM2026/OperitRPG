tion_detail"],"maxEntities":12,"lockedFactIds":["red-ridge:fact-5"]}},"rules":{"adapterId":"generic-d100-v1","adapterVersion":"1","skills":["调查","交涉","体能"],"resourceBounds":{"生命":{"min":0,"max":10},"补给":{"min":0,"max":20}},"difficulties":{"normal":0,"hard":-20,"easy":20},"allowedEffects":["move","resource","transfer_item","reveal_fact","objective","npc_status","npc_relation","knowledge","time"],"evidence":[{"ruleId":"red-ridge:check","source":{"sourceId":"module/sources/rules.md","sourceHash":"6133c43b3dac0abfa61a59718ca4a99a78863cd5cc755e709befbafd3c0381b5","anchor":"行动检定","authority":"module_rule"},"quote":"调查、交涉与技能检定使用百分骰。掷出1至100，点数小于等于技能加难度修正即成功。普通修正0，困难修正-20，容易修正20。失败仍推进游戏时间，不自动丢失生命或物品。","visibility":{"audience":"PUBLIC"}},{"ruleId":"red-ridge:travel","source":{"sourceId":"module/sources/rules.md","sourceHash":"6133c43b3dac0abfa61a59718ca4a99a78863cd5cc755e709befbafd3c0381b5","anchor":"移动和等待","authority":"module_rule"},"quote":"角色可以沿地图直接连接移动，每次移动推进10分钟。等待可以推进1至60分钟。未连接地点不可直接移动。","visibility":{"audience":"PUBLIC"}},{"ruleId":"red-ridge:people","source":{"sourceId":"module/sources/rules.md","sourceHash":"6133c43b3dac0abfa61a59718ca4a99a78863cd5cc755e709befbafd3c0381b5","anchor":"人物与物品","authority":"module_rule"},"quote":"角色可与同地点人物交涉。信任变化每次不超过20，总值限制-100至100。只有公开事实可通过告知建立人物知情关系。物品转移需要当前拥有者或在场接收者。","visibility":{"audience":"PUBLIC"}},{"ruleId":"red-ridge:clues","source":{"sourceId":"module/sources/rules.md","sourceHash":"6133c43b3dac0abfa61a59718ca4a99a78863cd5cc755e709befbafd3c0381b5","anchor":"调查与线索","authority":"module_rule"},"quote":"调查当前地点可以依照预设行动公开该处线索。章节目标需要相关线索成立后推进，不得凭旁白宣告完成。","visibility":{"audience":"PUBLIC"}}],"timeUnit":"分钟"},"sources":{"module/sources/rules.md":"# 原创通用百分骰规则\n## 行动检定\n调查、交涉与技能检定使用百分骰。掷出1至100，点数小于等于技能加难度修正即成功。普通修正0，困难修正-20，容易修正20。失败仍推进游戏时间，不自动丢失生命或物品。\n## 移动和等待\n角色可以沿地图直接连接移动，每次移动推进10分钟。等待可以推进1至60分钟。未连接地点不可直接移动。\n## 人物与物品\n角色可与同地点人物交涉。信任变化每次不超过20，总值限制-100至100。只有公开事实可通过告知建立人物知情关系。物品转移需要当前拥有者或在场接收者。\n## 调查与线索\n调查当前地点可以依照预设行动公开该处线索。章节目标需要相关线索成立后推进，不得凭旁白宣告完成。\n","module/sources/setting.md":"# 赤岭边境巡护\n\n边境风标连续失灵，牧民与测绘队互相指责。巡护队必须在沙暴前完成调查。\n\n## 主持资料\n旧测站排水槽堵塞改变了季节水路，风标零件被移作修井，冲突并非敌对势力所为。\n"}}